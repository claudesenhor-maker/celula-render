      "hora": "dia",
      "camera": "zoom_out",
      "atores": [
        "pessoa"
      ],
      "sfx": [
        "whoosh"
      ],
      "sem_arvores": true
    },
    {
      "texto": "Without them, a downpour can send more water downhill.",
